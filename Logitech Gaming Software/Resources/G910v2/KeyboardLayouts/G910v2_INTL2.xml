<keyboards layout="INTL2">

  <!-- Zone values are as follows (according to 0x8080) 
    0x0001 (1d):  Keyboard, code indicate the hid usage
    0x0004 (2d):  G-Keys, 1=G1, 2-G2, etc
    0x0010 (16d): Logo, 1=Logo, 2=Badge
  -->
  
  <!-- Logo, Badge, G-Keys, are universal and does not change for any layouts -->

