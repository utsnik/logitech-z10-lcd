<?xml version='1.0' encoding='utf-8'?>
<devicemanifest xmlns="http://www.logitech.com/Cassandra/2010.3/DeviceManifest">
    <device name="Monochrome LCD Emulator" model="Logitech.Gaming.Emulators.Mono" category="Logitech.Gaming.Emulators" >
        <probes>
            <lcdemulator_probe color="false" pid="0x10007" vid="0x1046d" />
        </probes>
        <thumbnails>
            <thumbnail state="normal" image="IDR_LCDMONOTN" />
        </thumbnails>
      <image>
        <layer image="IDR_MONOEMULATOR" name="device"/>
      </image> 
        <!-- What should be the profiler category?-->
        <profiler category="Logitech.Gaming.Emulators"/>
        <lcd type="mono" appbtndefault="quickswitch">
          <brightness default="2" min="0" max="2"/>
          <contrast default="66" min="0" max="100"/>
        </lcd>
        <feature view_id="device_view"/>
        <feature view_id="lcd_view"/>
        <deviceviewmetadata viewid="device_view">
            <transform scale="1.0" x="296" y="172"/>
          <hotspots>
            <hotspot viewid="lcd_view" image="IDR_EMULATOR_PULSEGLOW" left="286" top="162"/>
          </hotspots>
        </deviceviewmetadata>
        <lcdviewmetadata viewid="lcd_view" appbuttonbitmap="IDR_LCD_EMULATOR_APPLICATION_BUTTON">
            <transform scale="1.0" x="296" y="421"/>
        </lcdviewmetadata>
        <strings defaultlocale="en-US">
          <locale name="en-US">
            <string id="DEVICE_NAME">Monochrome LCD Emulator</string>
          </locale>
          <locale name="ja-JP">
            <string id="DEVICE_NAME">Monochrome LCD Emulator</string>
          </locale>
        </strings>
        <mediacontrols/>
    </device>
    <device name="Color LCD Emulator" model="Logitech.Gaming.Emulators.Color" category="Logitech.Gaming.Emulators" >
        <probes>
            <lcdemulator_probe color="true" pid="0x10008" vid="0x1046d"  />
        </probes>
        <thumbnails>
            <thumbnail state="normal" image="IDR_LCDCOLORTN" />
        </thumbnails>
        <image>
          <layer image="IDR_COLOREMULATOR" name="device"/>
        </image>
        <profiler category="Logitech.Gaming.Emulators"/>
        <lcd type="qvga" appbtndefault="finder">
          <brightness default="127" min="0" max="127"/>
        </lcd>
        <feature view_id="device_view"/>
        <feature view_id="lcd_view"/>
        <deviceviewmetadata viewid="device_view">
            <transform scale="1.0" x="296" y="172"/>
          <hotspots>
            <hotspot viewid="lcd_view" image="IDR_EMULATOR_PULSEGLOW" left="286" top="162"/>
          </hotspots>
        </deviceviewmetadata>
        <lcdviewmetadata viewid="lcd_view" appbuttonbitmap="IDR_LCD_EMULATOR_APPLICATION_BUTTON">
            <transform scale="1.0" x="296" y="421"/>
        </lcdviewmetadata>
      <strings defaultlocale="en-US">
        <locale name="en-US">
          <string id="DEVICE_NAME">Color LCD Emulator</string>
        </locale>
        <locale name="ja-JP">
          <string id="DEVICE_NAME">Color LCD Emulator</string>
        </locale>
      </strings>
      <mediacontrols/>
    </device>
</devicemanifest>
