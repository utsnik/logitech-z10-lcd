<?xml version='1.0' encoding='utf-8'?>
<devicemanifest xmlns="http://www.logitech.com/Cassandra/2010.2/DeviceManifest">
  <device model="Logitech.Gaming.Keyboard.G410">
    <thumbnails>
      <thumbnail image="IDR_G410_THUMBNAIL_NORMAL" state="normal"/>
    </thumbnails>
    <image>
      <layer image="IDR_G410_DEVICE" name="device"/>
    </image>
    <fwupdate minVersion="101.2.14" updatetool="G410/G410Update_v14.exe"/>
	<indicator name="firmwareUpdateIndicator"/>
    
	<profiler category="Logitech.Gaming.Keyboard">
      <shiftgroups>
        <group category="Logitech.Gaming.Keyboard"/>
      </shiftgroups>
    </profiler>
	<backlight defaultcolor="#FFFFFF" type="rgb"/>
	<colorLEDEffects enableGamma="0" enableInverseGamma="0">
      <!-- Color Cycle -->
      <effect id="3" minPeriod="1000" maxPeriod="20000" defaultPeriod="10000" intensity="255" >
        <fwBuildCondition build="5" condition="GTE" />
      </effect>
      <!-- Breathing (Waveform) -->
      <effect id="10" minPeriod="1000" maxPeriod="10000" defaultPeriod="5000" intensity="255" >
        <fwBuildCondition build="5" condition="GTE" />
      </effect>
      <!-- Color Wave -->
      <effect id="4" minPeriod="500" maxPeriod="5000" defaultPeriod="2000" intensity="255" >
        <fwBuildCondition build="5" condition="GTE" />
      </effect>
    </colorLEDEffects>
    <feature view_id="device_view"/>
    <feature view_id="per_key_lighting_view" />
    <feature view_id="f4522_disablekeys_view"/>
    <feature view_id="input_tracker_view"/>
    <input_tracker_view viewid="input_tracker_view">
      <transform x="100" y="160" scale="0.80"/>
      <heatmap image="IDR_LINE_KEYBOARD_G410_SVG" x="77" y="158" scale="0.65"/>
    </input_tracker_view>
    <deviceviewmetadata viewid="device_view">
      <transform x="55" y="120" scale="0.9"/>
      <hotspots>
        <hotspot viewid="f4522_disablekeys_view" image="IDR_G410_PULSEGLOW_GAME_MODE_SETTINGS" left="763" top="130"/>
      </hotspots>
    </deviceviewmetadata>
	<perkeylightingviewmetadata>
      <transform x="85" y="100" scale="0.85"/>
      <modes>
        <mode id="Effects"></mode>
        <mode id="PerKey"></mode>
      </modes>
    </perkeylightingviewmetadata>
    <f4522viewmetadata viewid="f4522_disablekeys_view">
      <transform x="85" y="160" scale="0.85"/>
	  <inactive>
	    <key zone="0x01" hid="0xE7"/>
		<key zone="0x40" hidden="true" hid="0x01"/>
		<key zone="0x40" hidden="true" hid="0x02"/>
	  </inactive>
    </f4522viewmetadata>
	
	<lighting_effect_editor_metadata>
      <transform scale="0.8" y ="135"/>
    </lighting_effect_editor_metadata>
	
    <strings defaultlocale="en-US">
      <locale name="en-US">
        <string id="DEVICE_NAME">Logitech G410 Atlas Spectrum</string>
      </locale>
      <locale name="ja-JP">
        <string id="DEVICE_NAME">Logicool G410 Atlas Spectrum</string>
      </locale>
    </strings>
  </device>
</devicemanifest>

