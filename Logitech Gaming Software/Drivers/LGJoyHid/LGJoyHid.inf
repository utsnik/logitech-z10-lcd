;; ./tip_hat rucosmer

[Version]
Signature="$CHICAGO$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Vendor%
DriverVer=04/22/2022, 9.04.030.0
CatalogFile=LGJoyHid.cat
PnpLockdown=1

[SourceDisksNames]
55=%DiskDesc%,,,

[SourceDisksFiles]
LGJoyHidLo32.sys=55
LGJoyHidLo64.sys=55
LGJoyHidFilter32.sys=55
LGJoyHidFilter64.sys=55
LGJoyFrc32.dll=55
LGJoyFrc64.dll=55

[DestinationDirs]
LGJoy.CopyUsbHidFilter32      = 10,system32\drivers
LGJoy.CopyUsbHidFilter64      = 10,system32\drivers
LGJoy.CopyLGJoyHidFilterSYS32 = 10,system32\drivers
LGJoy.CopyLGJoyHidFilterSYS64 = 10,system32\drivers
LGJoyFrc.Copy.DLL.SysWow64    = 10,syswow64
LGJoyFrc.Copy.DLL             = 10,system32\drivers

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%VENDOR%=Standard, NTx86, NTamd64

[Standard.NTx86]
%USB\VID_046D&PID_C24F.DeviceName%  = G29Inst32,         USB\VID_046D&PID_C24F&MI_00
%USB\VID_046D&PID_C262.DeviceName%  = G920Inst32,        USB\VID_046D&PID_C262
%HID\VID_046D&PID_C24F.DeviceName%  = LGJoy.HidFilter32, HID\VID_046D&PID_C24F&MI_00
%HID\VID_046D&PID_C262.DeviceName%  = LGJoy.HidFilter32, HID\VID_046D&PID_C262&Col01
%HID\VID_046D&PID_C22D.DeviceName%  = LGJoy.HidFilter32, HID\VID_046D&PID_C22D&MI_01&Col01
%HID\VID_046D&PID_C22E.DeviceName%  = LGJoy.HidFilter32, HID\VID_046D&PID_C22E&MI_01&Col01

[Standard.NTamd64]
%USB\VID_046D&PID_C24F.DeviceName%  = G29Inst64,         USB\VID_046D&PID_C24F&MI_00
%USB\VID_046D&PID_C262.DeviceName%  = G920Inst64,        USB\VID_046D&PID_C262
%HID\VID_046D&PID_C24F.DeviceName%  = LGJoy.HidFilter64, HID\VID_046D&PID_C24F&MI_00
%HID\VID_046D&PID_C262.DeviceName%  = LGJoy.HidFilter64, HID\VID_046D&PID_C262&Col01
%HID\VID_046D&PID_C22D.DeviceName%  = LGJoy.HidFilter64, HID\VID_046D&PID_C22D&MI_01&Col01
%HID\VID_046D&PID_C22E.DeviceName%  = LGJoy.HidFilter64, HID\VID_046D&PID_C22E&MI_01&Col01

[LGJoy.HidFilter32]
CopyFiles = LGJoy.CopyLGJoyHidFilterSYS32

[LGJoy.HidFilter64]
CopyFiles = LGJoy.CopyLGJoyHidFilterSYS64

[G29Inst32]
Include=Input.inf
Needs=HID_Inst.NT
CopyFiles=LGJoy.CopyUsbHidFilter32, LGJoyFrc.Copy.DLL
AddReg=G29Inst32.AddReg, G29Inst.AddReg, LGJoy.LGJoyFrcDLL.AddReg32

[G29Inst64]
Include=Input.inf
Needs=HID_Inst.NT
CopyFiles=LGJoy.CopyUsbHidFilter64, LGJoyFrc.Copy.DLL, LGJoyFrc.Copy.DLL.SysWow64
AddReg=G29Inst64.AddReg, G29Inst.AddReg, LGJoy.LGJoyFrcDLL.AddReg64

[G29Inst32.HW]
AddReg=LGJoyHidLo.HW.AddReg

[G29Inst64.HW]
AddReg=LGJoyHidLo.HW.AddReg

[G920Inst32]
Include=Input.inf
Needs=HID_Inst.NT
CopyFiles=LGJoy.CopyUsbHidFilter32
AddReg=G920Inst.AddReg

[G920Inst64]
Include=Input.inf
Needs=HID_Inst.NT
CopyFiles=LGJoy.CopyUsbHidFilter64
AddReg=G920Inst.AddReg

[G920Inst32.HW]
AddReg=LGJoyHidLo.HW.AddReg

[G920Inst64.HW]
AddReg=LGJoyHidLo.HW.AddReg

[LGJoyHidLo.HW.AddReg]
HKR,,"LowerFilters",0x00010000,"LGJoyHidLo"

[LGJoy.HidFilter32.Services]
AddService = LGJoyHidFilter,0x00000002,LGJoyHidFilter_Service_Inst32

[LGJoy.HidFilter64.Services]
AddService = LGJoyHidFilter,0x00000002,LGJoyHidFilter_Service_Inst64

[G29Inst32.Services]
Include=Input.inf
Needs=HID_Inst.NT.Services
AddService = LGJoyHidLo,,LGJoyHidLo_Service_Inst32

[G29Inst64.Services]
Include=Input.inf
Needs=HID_Inst.NT.Services
AddService = LGJoyHidLo,,LGJoyHidLo_Service_Inst64

[G920Inst32.Services]
Include=Input.inf
Needs=HID_Inst.NT.Services
AddService = LGJoyHidLo,,LGJoyHidLo_Service_Inst32

[G920Inst64.Services]
Include=Input.inf
Needs=HID_Inst.NT.Services
AddService = LGJoyHidLo,,LGJoyHidLo_Service_Inst64

[LGJoyHidFilter_Service_Inst32]
DisplayName    = %LGJoyHidFilter32.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\LGJoyHidFilter32.sys

[LGJoyHidFilter_Service_Inst64]
DisplayName    = %LGJoyHidFilter64.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\LGJoyHidFilter64.sys

[LGJoyHidLo_Service_Inst32]
DisplayName    = %LGJoyHidLo32.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\LGJoyHidLo32.sys

[LGJoyHidLo_Service_Inst64]
DisplayName    = %LGJoyHidLo64.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\LGJoyHidLo64.sys

;-------------COPY FILEs ---------------------------------------------

[LGJoy.CopyLGJoyHidFilterSYS32]
LGJoyHidFilter32.sys

[LGJoy.CopyLGJoyHidFilterSYS64]
LGJoyHidFilter64.sys

[LGJoy.CopyUsbHidFilter32]
LGJoyHidLo32.sys

[LGJoy.CopyUsbHidFilter64]
LGJoyHidLo64.sys

[LGJoyFrc.Copy.DLL.SysWow64]
LGJoyFrc32.dll

[LGJoyFrc.Copy.DLL]
LGJoyFrc64.dll

;-------------ADD REGs ---------------------------------------------
[LGJoy.LGJoyFrcDLL.AddReg32]
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%,,,%CLSID_LGJoyFrcDLL_Config.Desc%
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,,,%%SystemRoot%%\system32\drivers\LGJoyFrc32.dll
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,ThreadingModel,,"Apartment"

[LGJoy.LGJoyFrcDLL.AddReg64]
HKCR,Wow6432Node\CLSID\%CLSID_LGJoyFrcDLL_Config%,,,%CLSID_LGJoyFrcDLL_Config.Desc%
HKCR,Wow6432Node\CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,,,%%SystemRoot%%\SysWow64\LGJoyFrc32.dll
HKCR,Wow6432Node\CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,ThreadingModel,,"Apartment"
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%,,,%CLSID_LGJoyFrcDLL_Config.Desc%
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,,,%%SystemRoot%%\system32\drivers\LGJoyFrc64.dll
HKCR,CLSID\%CLSID_LGJoyFrcDLL_Config%\InProcServer32,ThreadingModel,,"Apartment"

[G29Inst32.AddReg]
HKCR,CLSID\%CLSID_G29_FF%,,,%CLSID_LGFF.Desc%
HKCR,CLSID\%CLSID_G29_FF%\InProcServer32,,,%%SystemRoot%%\system32\drivers\LGJoyFrc32.dll
HKCR,CLSID\%CLSID_G29_FF%\InProcServer32,ThreadingModel,,"Both"

[G29Inst64.AddReg]
HKCR,Wow6432Node\CLSID\%CLSID_G29_FF%,,,%CLSID_LGFF.Desc%
HKCR,Wow6432Node\CLSID\%CLSID_G29_FF%\InProcServer32,,,%%SystemRoot%%\SysWow64\LGJoyFrc32.dll
HKCR,Wow6432Node\CLSID\%CLSID_G29_FF%\InProcServer32,ThreadingModel,,"Both"
HKCR,CLSID\%CLSID_G29_FF%,,,%CLSID_LGFF.Desc%
HKCR,CLSID\%CLSID_G29_FF%\InProcServer32,,,%%SystemRoot%%\system32\drivers\LGJoyFrc64.dll
HKCR,CLSID\%CLSID_G29_FF%\InProcServer32,ThreadingModel,,"Both"

