[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
provider=%ProviderName%
CatalogFile=lgAudio.cat
DriverVer=03/08/2018,8.98.201

[SourceDisksNames]
222=%DiskDescription%,,,

[SourceDisksFiles]
LogiHeadsetCaptureAPO.dll=222
LogiHeadsetRenderAPO.dll=222
LogiSpeakerAPO.dll=222
ladfGSS.sys=222

[SignatureAttributes]
LogiHeadsetCaptureAPO.dll=SignatureAttributes.PETrust
LogiHeadsetRenderAPO.dll=SignatureAttributes.PETrust
LogiSpeakerAPO.dll=SignatureAttributes.PETrust

[SignatureAttributes.PETrust]
PETrust=true

[DestinationDirs]
lgAudio.CopySysList=11  ; %windir%\system32
lgAudio.Speaker.CopySysList=11  ; %windir%\system32
lgAudio.CopyDrvList=10,system32\drivers

;; Excluding drivers from the "Add New Hardware" list.  Uncomment this when shipping your product.
[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%MfgName%=LogitechGserie, NTx86, NTamd64

[LogitechGserie.NTx86]
%lgAudio_G430_Descr%=lgAudio_G430,USB\VID_046D&PID_0A4D&MI_00   ;; G430 headset
%lgAudio_G930_Descr%=lgAudio_G930,USB\VID_046D&PID_0A1F&MI_00   ;; G930 headset
%lgAudio_G35_Descr%=lgAudio_G35,USB\VID_046D&PID_0A15&MI_00     ;; G35 headset
%lgAudio_G933_Descr%=lgAudio_G933,USB\VID_046D&PID_0A5B&MI_00   ;; G933 headset
%lgAudio_G633_Descr%=lgAudio_G633,USB\VID_046D&PID_0A5C&MI_00   ;; G633 headset
%lgAudio_G533_Descr%=lgAudio_G533,USB\VID_046D&PID_0A66&MI_00   ;; G533 headset
%lgAudio_G433_Descr%=lgAudio_G433,USB\VID_046D&PID_0A6D&MI_00   ;; G533 headset
%lgAudio_G560_Descr%=lgAudio_G560,USB\VID_046D&PID_0A78&MI_00   ;; G560 speaker

[LogitechGserie.NTamd64]
%lgAudio_G430_Descr%=lgAudio_G430,USB\VID_046D&PID_0A4D&MI_00   ;; G430 headset
%lgAudio_G930_Descr%=lgAudio_G930,USB\VID_046D&PID_0A1F&MI_00   ;; G930 headset
%lgAudio_G35_Descr%=lgAudio_G35,USB\VID_046D&PID_0A15&MI_00     ;; G35 headset
%lgAudio_G933_Descr%=lgAudio_G933,USB\VID_046D&PID_0A5B&MI_00   ;; G933 headset
%lgAudio_G633_Descr%=lgAudio_G633,USB\VID_046D&PID_0A5C&MI_00   ;; G633 headset
%lgAudio_G533_Descr%=lgAudio_G533,USB\VID_046D&PID_0A66&MI_00   ;; G533 headset
%lgAudio_G433_Descr%=lgAudio_G433,USB\VID_046D&PID_0A6D&MI_00   ;; G533 headset
%lgAudio_G560_Descr%=lgAudio_G560,USB\VID_046D&PID_0A78&MI_00   ;; G560 speaker

;; G430 specific section
[lgAudio_G430]
Include      = ks.inf, wdmaudio.inf, wdma_usb.inf
Needs        = KS.Registration, WDMAUDIO.Registration, USBAudioOEM.CopyFiles, USBAudioOEM.AddReg
CopyFiles    = lgAudio.CopySysList,lgAudio.CopyDrvList
AddProperty  = lgAudio.AddProperty
AddReg       = lgAudio.HeadsetRender.AddReg, lgAudio.HeadsetCapture.AddReg
RegisterDlls = lgAudio.RegisterDlls

[lgAudio_G430.HW]
AddReg=ladfGSS.HW.AddReg

[lgAudio_G430.Services]
Include = wdma_usb.inf
Needs   = USBAudio.Services
AddService = ladfGSS,,ladfGSS_Service_Inst

[lgAudio_G430.Interfaces]
AddInterface="{6994AD04-93EF-11D0-A3CC-00A0C9223196}", "GLOBAL", lgAudio_G430.Topology
AddInterface="{65E8773E-8F56-11D0-A3B9-00A0C9223196}", "GLOBAL", lgAudio_G430.Topology
AddInterface="{DDA54A40-1E4C-11D1-A050-405705C10000}", "GLOBAL", lgAudio_G430.Topology
AddInterface="{65E8773D-8F56-11D0-A3B9-00A0C9223196}", "GLOBAL", lgAudio.Capture.Topology

[lgAudio_G430.Topology]
AddReg = lgAudio_G430.AddReg, lgAudioHeadsetRenderFX.AddReg, lgAudioHeadsetCaptureFX.AddReg


