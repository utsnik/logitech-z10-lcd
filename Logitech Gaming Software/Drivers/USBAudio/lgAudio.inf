;; Back to general sections.

[ladfGSS_Service_Inst]
DisplayName    = %ladfGSS.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 0 ; SERVICE_ERROR_IGNORE
ServiceBinary  = %10%\system32\drivers\ladfGSS.sys

[ladfGSS.HW.AddReg]
HKR,,"UpperFilters",0x00010000,"ladfGSS"

[lgAudio.Capture.Topology]
AddReg = lgAudioHeadsetCaptureFX.AddReg

;;
;; Register custom system audio effects and property page
;;
[lgAudio.RegisterDlls]
11,,LogiHeadsetCaptureAPO.dll,1
11,,LogiHeadsetRenderAPO.dll,1

[lgAudio.Speaker.RegisterDlls]
11,,LogiSpeakerAPO.dll,1

[lgAudio.AddProperty]
DeviceVendorWebSite,,,,%LogiWebSite%

